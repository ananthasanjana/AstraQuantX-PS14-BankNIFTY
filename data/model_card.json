{
  "model": "RandomForestClassifier - DUAL (VWAP + Bollinger) meta-filter",
  "file": "rf_model.joblib",
  "purpose": "LIVE scoring only. Backtest results come from walk-forward models (review3_signals.csv).",
  "trained_on": {
    "sessions": "2026-10-13 -> 2026-11-13",
    "candidates": 53,
    "positive_rate": 0.5283
  },
  "params": {
    "n_estimators": 300,
    "max_depth": 4,
    "min_samples_leaf": 3,
    "class_weight": "balanced",
    "random_state": 42,
    "n_jobs": 1
  },
  "label": "1 if the ATM premium hits +12% before -6% within 12 bars",
  "feature_order": [
    "d_vwap",
    "d_vwap_chg3",
    "vwap_slope6",
    "z",
    "BW",
    "BW_chg5",
    "ma_slope6",
    "vol_ratio",
    "mins_since_open",
    "ret_1bar",
    "side"
  ],
  "feature_formulas": {
    "d_vwap": "(close - vwap) / vwap",
    "d_vwap_chg3": "d_vwap - d_vwap.shift(3)",
    "vwap_slope6": "vwap.pct_change(6)",
    "z": "(close - ma20) / sd20   (sd20 = population std, ddof=0)",
    "BW": "(upper - lower) / ma20   (upper/lower = ma20 +/- 2*sd20)",
    "BW_chg5": "BW.pct_change(5)",
    "ma_slope6": "ma20.pct_change(6)",
    "vol_ratio": "volume / volume.rolling(20).mean()",
    "mins_since_open": "hour*60 + minute - 555   (minutes since 09:15 IST)",
    "ret_1bar": "close.pct_change()",
    "side": "+1 for a BUY_CE candidate, -1 for BUY_PE"
  },
  "candidate_rule": {
    "BUY_CE": "close > vwap AND z[t-1] <= -0.5 AND z[t] > -0.5 AND 09:30 <= time <= 14:30",
    "BUY_PE": "close < vwap AND z[t-1] >= 0.5 AND z[t] < 0.5 AND 09:30 <= time <= 14:30"
  },
  "versions": {
    "scikit-learn": "1.6.1",
    "joblib": "1.5.3",
    "numpy": "2.0.2",
    "pandas": "2.3.3"
  },
